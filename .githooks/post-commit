#!/bin/sh
# Keeps at most 5 local branches (by last commit date) besides main, master,
# and the branch you are on. Older branches are removed with: git branch -D
# (Unmerged branches are still deleted—recover via reflog if needed.)
#
# Enable once per clone:  git config core.hooksPath .githooks

current=$(git symbolic-ref --short HEAD 2>/dev/null) || exit 0

gitdir=$(git rev-parse --git-dir)
tmp="$gitdir/post-commit-prune-branches.$$"
trap 'rm -f "$tmp"' EXIT

git for-each-ref --sort=-committerdate --format='%(refname:short)' refs/heads/ |
while read -r b; do
	[ "$b" = main ] && continue
	[ "$b" = master ] && continue
	[ "$b" = "$current" ] && continue
	echo "$b"
done >"$tmp"

line=0
while read -r b; do
	[ -z "$b" ] && continue
	line=$((line + 1))
	if [ "$line" -le 5 ]; then
		continue
	fi
	git branch -D "$b" 2>/dev/null || true
done <"$tmp"
